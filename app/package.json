{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "handoff:env": "tsx scripts/check-prod-env.ts",
    "handoff:slots": "tsx scripts/test-booking-slots.ts",
    "handoff:tokens": "tsx scripts/test-token-replay.ts",
    "handoff:statuses": "tsx scripts/test-admin-statuses.ts",
    "handoff:public-guards": "tsx scripts/test-public-provider-guards.ts",
    "handoff:public-schema": "tsx scripts/check-public-schema.ts",
    "handoff:live": "tsx scripts/check-live-deployment.ts",
    "handoff:smoke": "tsx scripts/e2e-handoff-smoke.ts",
    "test:bulk-selection": "tsx scripts/test-bulk-selection.ts",
    "test:admin-mutations": "tsx scripts/test-admin-mutations.ts",
    "verify:admin-inspector": "tsx --env-file .env.local scripts/verify-admin-inspector-flows.ts",
    "release:verify": "npm run handoff:public-guards && npm run test:bulk-selection && npm run test:admin-mutations && npm run handoff:slots && npm run handoff:tokens && npm run handoff:statuses && npm run lint && tsc --noEmit && npm run build",
    "qa:browser-seed": "tsx scripts/browserQaSeed.ts create",
    "qa:browser-cleanup": "tsx scripts/browserQaSeed.ts cleanup",
    "qa:cleanup-artifacts": "tsx scripts/cleanupQaArtifacts.ts",
    "seed:dev-users": "tsx --env-file .env.local scripts/seed-dev-users.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "@vercel/analytics": "^1.6.1",
    "next": "^16.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pg": "^8.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
